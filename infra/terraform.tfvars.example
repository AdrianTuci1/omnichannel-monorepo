# Copiați în terraform.tfvars și ajustați valorile înainte de `terraform apply`.

environment        = "dev"
name_prefix        = "omni"
location           = "West Europe"

# Autentificare (opțional; altfel se folosește `az login` sau ARM_* env vars)
# subscription_id    = "00000000-0000-0000-0000-000000000000"
# tenant_id          = "00000000-0000-0000-0000-000000000000"

kubernetes_version = "1.31"

aks_system_node_size = "Standard_D2ds_v5"
aks_system_node_min  = 1
aks_system_node_max  = 3

aks_user_node_size = "Standard_D4ds_v5"
aks_user_node_min  = 2
aks_user_node_max  = 6

# Înlocuiți obligatoriu înainte de apply:
postgres_admin_login    = "omniadmin"
postgres_admin_password = "schimba-ma-cu-o-parola-puternica"

postgres_version             = "16"
postgres_sku_name            = "GP_Standard_D2ds_v4"
postgres_storage_mb          = 32768
postgres_backup_retention_days = 7
postgres_high_availability   = true
postgres_database_name       = "store"

redis_sku_name = "Standard"
redis_capacity = 1
redis_version  = "6"

service_bus_sku    = "Standard"
service_bus_queues = ["orders", "inventory-reserved", "notifications"]
