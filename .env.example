# =============================================================================
# Omnichannel — configurare de mediu (valori de exemplu, NU secrete reale)
#
# Copiază în .env și completează cu valori proprii:
#   cp .env.example .env
#
# .env este ignorat de git (vezi .gitignore). Nu comita secrete reale.
# =============================================================================

# ---- PostgreSQL (baza de date; imaginea pgvector/pgvector:pg16) ----
# Folosește o parolă alfanumerică, fără caractere speciale Npgsql ( ; @ $ \" ).
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Store API folosește PostgreSQL DOAR dacă această variabilă este setată.
# Lasă-o goală pentru modul InMemory (dev — funcționează out-of-the-box, fără migrări).
# Pentru producție, completează un connection string Npgsql (parola trebuie să
# coincidă cu POSTGRES_PASSWORD de mai sus) și aplică migrările EF Core:
#   CONNECTION_STRINGS__STOREAPI=Host=postgres;Port=5432;Database=store;Username=store;Password=<parola>
CONNECTION_STRINGS__STOREAPI=

# ---- JWT (cheia de semnare a token-urilor store-api, minim 32 caractere) ----
# Generează una puternică cu: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ---- Azure Service Bus (opțional, doar pentru consumul de evenimente din CDP) ----
# Lăsate goale, CDP consumă evenimente exclusiv prin poller-ul store-api
# (GET /events?since=...). Completează ConnectionString + QueueName (mod coadă)
# sau TopicName + SubscriptionName (mod topic) pentru a activa și Service Bus.
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=
SERVICEBUS_TOPIC_NAME=omnichannel-events
SERVICEBUS_SUBSCRIPTION_NAME=cdp-worker

# ---- Observabilitate: Grafana (login implicit admin/admin pentru dev) ----
# Schimbă în producție. Serviciile Prometheus/Grafana/OTel Collector se
# pornesc cu `docker compose up -d prometheus grafana otel-collector`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
