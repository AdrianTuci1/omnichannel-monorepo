{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StoreApi": {
    "BaseUrl": "http://localhost:5180"
  },
  "Recommender": {
    "DefaultLimit": 10,
    "MaxLimit": 50,
    "ContentWeight": 0.6,
    "MinSimilarity": 0.0,
    "CandidateMultiplier": 3
  }
}
